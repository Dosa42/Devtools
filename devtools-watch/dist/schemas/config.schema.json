{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "devtools-watch config v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "parents",
    "targets",
    "proof_executable",
    "poll_ms",
    "verify_interval_ms"
  ],
  "properties": {
    "schema": {
      "const": "devtools-watch.config/1"
    },
    "parents": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "targets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "root"
        ],
        "properties": {
          "root": {
            "type": "string"
          },
          "checksums": {
            "type": "string",
            "default": "checksums.sha"
          },
          "checksum_signature": {
            "type": "string",
            "default": "checksums.sha.sig"
          },
          "provenance": {
            "type": "string",
            "default": "provenance.json"
          },
          "provenance_signature": {
            "type": "string",
            "default": "provenance.json.sig"
          },
          "public_key": {
            "type": [
              "string",
              "null"
            ],
            "default": null
          }
        }
      }
    },
    "proof_executable": {
      "type": "string",
      "minLength": 1
    },
    "poll_ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 18446744073709551615
    },
    "verify_interval_ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 18446744073709551615
    }
  }
}
