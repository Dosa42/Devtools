.class public interface abstract Lorg/mozilla/gecko/util/EventCallback;
.super Ljava/lang/Object;
.source "SourceFile"


# annotations
.annotation build Lorg/mozilla/gecko/annotation/RobocopTarget;
.end annotation

.annotation runtime Lorg/mozilla/gecko/annotation/WrapForJNI;
    calledFrom = "gecko"
.end annotation


# virtual methods
.method public abstract sendError(Ljava/lang/Object;)V
.end method

.method public abstract sendSuccess(Ljava/lang/Object;)V
.end method
