#!/bin/bash

# Could be needed for dbus?
export XDG_RUNTIME_DIR=/run/user/$(id -u)
mkdir -p $XDG_RUNTIME_DIR

# Generate locale if not available,
if validlocale $LC_ALL |& grep -q 'not available'; then
  echo "$LC_ALL UTF-8" > /etc/locale.gen
  locale-gen $LC_ALL

  # Revert to English if still not available,
  if validlocale $LC_ALL |& grep -q 'not available'; then

    # Generate English if needed,
    if validlocale en_US.UTF-8 |& grep -q 'not available'; then
      echo "en_US.UTF-8 UTF-8" > /etc/locale.gen
      locale-gen en_US.UTF-8
    fi

    # Set to English,
    export LC_ALL=en_US.UTF-8
    export LANG=en_US.UTF-8
    export LANGUAGE=en_US.UTF-8
  fi
fi

# Mostly, lxde startup script (startlxde),
export XDG_DATA_DIRS="/usr/local/share/:/usr/share/:/usr/share/gdm/:/var/lib/menu-xdg/"

if [ -z "$XDG_CONFIG_HOME" ]; then
	export XDG_CONFIG_HOME="$HOME/.config"
fi

if [ -z "$XDG_DATA_HOME" ]; then
	export XDG_DATA_HOME="$HOME/.local/share"
fi

# Ensure the existance of the 'Desktop' folder
if [ -e "$XDG_CONFIG_HOME/user-dirs.dirs" ]; then
	. "$XDG_CONFIG_HOME/user-dirs.dirs"
else
	XDG_DESKTOP_DIR="$HOME/Desktop"
fi
mkdir -p "$XDG_DESKTOP_DIR"

# Ensure the existance of the user applications folder
USER_APPS_DIR="$XDG_DATA_HOME/applications"
mkdir -p "$USER_APPS_DIR"

# Enable GTK+2 integration for OpenOffice.org, if available.
export SAL_USE_VCLPLUGIN=gtk

# Launch DBus if needed
if which dbus-launch >/dev/null && test -z "$DBUS_SESSION_BUS_ADDRESS"; then
	if test -z "$XDG_RUNTIME_DIR" -o ! -S "$XDG_RUNTIME_DIR/bus" -o ! -O "$XDG_RUNTIME_DIR/bus"; then
		eval "$(dbus-launch --sh-syntax --exit-with-session)"
	fi
fi

# See: https://wiki.archlinux.org/title/PCManFM#No_.22Applications.22
#export XDG_MENU_PREFIX="lxde-"
#export XDG_CURRENT_DESKTOP="LXDE"
export XDG_MENU_PREFIX="gnome-"
export XDG_CURRENT_DESKTOP="GNOME"
export XDG_SESSION_TYPE="x11"     # Required for plank

# Start dbus service (needed for gnome-software),
service dbus start

# Create apt required directories,
mkdir -p /var/log/apt

# Start ibus (input language handler),
export GTK_IM_MODULE=ibus
export XMODIFIERS=@im=ibus
export QT_IM_MODULE=ibus
ibus-daemon -d -r

# Launch desktop,
cd ~
xcompmgr &
openbox &
sh ~/.fehbg
plank &

if [[ $START_ULAUNCHER = "1" ]] ; then
    sleep 3
    ulauncher --hide-window --no-window-shadow & # https://github.com/Ulauncher/Ulauncher/issues/451
fi
