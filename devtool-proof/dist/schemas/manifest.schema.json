{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Manifest",
  "type": "object",
  "properties": {
    "algorithm": {
      "$ref": "#/$defs/Algorithm"
    },
    "entries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Record"
      }
    },
    "schema": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "required": [
    "schema",
    "algorithm",
    "entries"
  ],
  "$defs": {
    "Algorithm": {
      "type": "string",
      "enum": [
        "sha256",
        "sha512"
      ]
    },
    "Record": {
      "type": "object",
      "properties": {
        "bytes": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "hash": {
          "type": "string"
        },
        "path": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "path",
        "hash"
      ]
    }
  }
}
