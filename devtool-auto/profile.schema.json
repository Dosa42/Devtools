{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "devtool-auto profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "name",
    "cwd",
    "repeat",
    "interval_ms",
    "env",
    "steps"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "name": {
      "type": "string",
      "pattern": "^(?!\\.{1,2}$)[A-Za-z0-9_.-]+$"
    },
    "cwd": {
      "type": "string"
    },
    "repeat": {
      "type": "integer",
      "minimum": 1
    },
    "interval_ms": {
      "type": "integer",
      "minimum": 0
    },
    "env": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "cwd",
          "env",
          "delay_ms",
          "action"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "cwd": {
            "type": [
              "string",
              "null"
            ]
          },
          "env": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "delay_ms": {
            "type": "integer",
            "minimum": 0
          },
          "action": {
            "oneOf": [
              {
                "type": "object",
                "required": [
                  "kind",
                  "program",
                  "args"
                ],
                "properties": {
                  "kind": {
                    "const": "exec"
                  },
                  "program": {
                    "type": "string"
                  },
                  "args": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              },
              {
                "type": "object",
                "required": [
                  "kind",
                  "command"
                ],
                "properties": {
                  "kind": {
                    "const": "shell"
                  },
                  "command": {
                    "type": "string"
                  }
                }
              }
            ]
          }
        }
      }
    },
    "timer": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "after_ms",
            "interval_ms",
            "runs"
          ],
          "properties": {
            "after_ms": {
              "type": "integer",
              "minimum": 0,
              "maximum": 18446744073709551615
            },
            "interval_ms": {
              "type": "integer",
              "minimum": 1,
              "maximum": 18446744073709551615
            },
            "runs": {
              "type": "integer",
              "minimum": 0,
              "maximum": 18446744073709551615
            }
          }
        }
      ]
    },
    "watch": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "paths",
            "recursive",
            "poll_ms",
            "debounce_ms",
            "initial",
            "runs"
          ],
          "properties": {
            "paths": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            },
            "recursive": {
              "type": "boolean"
            },
            "poll_ms": {
              "type": "integer",
              "minimum": 1,
              "maximum": 18446744073709551615
            },
            "debounce_ms": {
              "type": "integer",
              "minimum": 0,
              "maximum": 18446744073709551615
            },
            "initial": {
              "type": "boolean"
            },
            "runs": {
              "type": "integer",
              "minimum": 0,
              "maximum": 18446744073709551615
            }
          }
        }
      ]
    }
  }
}
